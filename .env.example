# Template konfigurasi lingkungan SiagaBanjir (AMAN dilacak Git — jangan isi API key asli di file ini).
# Salin berkas ini menjadi `.env` lokal dan isi kredensial Anda sendiri.

# Provider & Model (OD-02: tetapkan model spesifik setelah hasil tes aktual WF-016 / scripts/test_api.py)
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=groq
PRIMARY_MODEL=TBD_AFTER_WF016
FALLBACK_MODEL=TBD_AFTER_WF016

# Parameter LLM terkendali (nilai awal sementara, dapat dikalibrasi pada WF-016..WF-017)
# Batas output 1400 token dipakai identik pada Baseline & RAG agar respons multi-fase utuh.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SEC=30

# Versi prompt dasar (wajib identik antara mode Baseline dan RAG saat eksperimen)
PROMPT_VERSION=prompt_v1.3

# Kredensial API (ISI HANYA DI FILE `.env` LOKAL YANG DIABAIKAN GIT)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Path korpus frozen hasil handoff Member B / Ramadan (read-only untuk pipeline)
CORPUS_MANIFEST_PATH=data/processed/corpus_manifest.json
CORPUS_CHUNKS_PATH=data/processed/chunks.jsonl

# Parameter retrieval & Evidence Gate (TD-03: dikalibrasi pada WF-018..WF-021)
RETRIEVAL_TOP_K=4
EVIDENCE_MIN_SCORE=0.15

# Lokasi log JSONL lokal
LOG_DIR=logs
